<?xml version="1.0" ?>
<robot name="cyberpunk_base">

  <!-- ================= MATERIALS ================= -->
  <material name="matte_black">  <color rgba="0.1 0.1 0.12 1.0"/> </material>
  <material name="neon_cyan">    <color rgba="0.0 1.0 0.8 1.0"/>  </material>
  <material name="power_red">    <color rgba="0.8 0.1 0.1 1.0"/>  </material>
  <material name="pcb_green">    <color rgba="0.1 0.4 0.2 1.0"/>  </material>
  <material name="rubber_dark">  <color rgba="0.05 0.05 0.05 1.0"/> </material>

  <!-- ================= LOWER DECK (POWER & DRIVE) ================= -->
  <link name="lower_deck">
    <visual>
      <geometry>
        <!-- Chamfered representation using a core box, 260x180x10mm -->
        <box size="0.26 0.18 0.01"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
  </link>

  <!-- Battery Cradle Proxy (Center Mass) -->
  <joint name="battery_joint" type="fixed">
    <parent link="lower_deck"/>
    <child link="battery"/>
    <origin xyz="-0.02 0 0.015" rpy="0 0 0"/>
  </joint>
  <link name="battery">
    <visual>
      <geometry> <box size="0.11 0.04 0.025"/> </geometry>
      <material name="power_red"/>
    </visual>
  </link>

  <!-- ================= WHEELS ================= -->
  <!-- Left Wheel -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="lower_deck"/>
    <child link="left_wheel"/>
    <origin xyz="-0.05 0.105 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="left_wheel">
    <visual>
      <geometry> <cylinder radius="0.0325" length="0.026"/> </geometry>
      <material name="rubber_dark"/>
    </visual>
  </link>

  <!-- Right Wheel -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="lower_deck"/>
    <child link="right_wheel"/>
    <origin xyz="-0.05 -0.105 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="right_wheel">
    <visual>
      <geometry> <cylinder radius="0.0325" length="0.026"/> </geometry>
      <material name="rubber_dark"/>
    </visual>
  </link>

  <!-- Front Caster Wheel (Stability) -->
  <joint name="caster_joint" type="fixed">
    <parent link="lower_deck"/>
    <child link="caster_wheel"/>
    <origin xyz="0.10 0 -0.015" rpy="0 0 0"/>
  </joint>
  <link name="caster_wheel">
    <visual>
      <geometry> <sphere radius="0.015"/> </geometry>
      <material name="neon_cyan"/>
    </visual>
  </link>

  <!-- ================= UPPER DECK (NEURAL LOGIC) ================= -->
  <joint name="deck_spacer" type="fixed">
    <parent link="lower_deck"/>
    <child link="upper_deck"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/> <!-- 40mm gap for wiring and battery -->
  </joint>
  <link name="upper_deck">
    <visual>
      <geometry> <box size="0.26 0.18 0.005"/> </geometry>
      <material name="matte_black"/>
    </visual>
  </link>

  <!-- Raspberry Pi 5 Proxy -->
  <joint name="rpi_joint" type="fixed">
    <parent link="upper_deck"/>
    <child link="raspberry_pi"/>
    <origin xyz="-0.06 -0.045 0.01" rpy="0 0 0"/>
  </joint>
  <link name="raspberry_pi">
    <visual>
      <geometry> <box size="0.085 0.056 0.015"/> </geometry>
      <material name="pcb_green"/>
    </visual>
  </link>

  <!-- ESP32 NodeMCU Proxy -->
  <joint name="esp_joint" type="fixed">
    <parent link="upper_deck"/>
    <child link="esp32"/>
    <origin xyz="-0.08 0.04 0.01" rpy="0 0 0"/>
  </joint>
  <link name="esp32">
    <visual>
      <geometry> <box size="0.052 0.028 0.01"/> </geometry>
      <material name="matte_black"/>
    </visual>
  </link>

  <!-- PCA9685 Servo Driver Proxy -->
  <joint name="pca_joint" type="fixed">
    <parent link="upper_deck"/>
    <child link="pca9685"/>
    <origin xyz="0.02 0 0.01" rpy="0 0 0"/>
  </joint>
  <link name="pca9685">
    <visual>
      <geometry> <box size="0.062 0.025 0.01"/> </geometry>
      <material name="neon_cyan"/>
    </visual>
  </link>

  <!-- ================= SENSORY ARRAY (FRONT) ================= -->
  <!-- Ultrasonic Radar Mount -->
  <joint name="sonar_joint" type="fixed">
    <parent link="lower_deck"/>
    <child link="ultrasonic"/>
    <origin xyz="0.13 0 0.02" rpy="0 0 0"/>
  </joint>
  <link name="ultrasonic">
    <visual>
      <geometry> <box size="0.01 0.045 0.02"/> </geometry>
      <material name="neon_cyan"/>
    </visual>
  </link>

  <!-- Pi Camera Tilted Mount -->
  <joint name="camera_joint" type="fixed">
    <parent link="upper_deck"/>
    <child link="pi_camera"/>
    <origin xyz="0.12 0 0.025" rpy="0 0.261 0"/> <!-- Tilted down ~15 degrees -->
  </joint>
  <link name="pi_camera">
    <visual>
      <geometry> <box size="0.01 0.025 0.025"/> </geometry>
      <material name="matte_black"/>
    </visual>
  </link>

</robot>
